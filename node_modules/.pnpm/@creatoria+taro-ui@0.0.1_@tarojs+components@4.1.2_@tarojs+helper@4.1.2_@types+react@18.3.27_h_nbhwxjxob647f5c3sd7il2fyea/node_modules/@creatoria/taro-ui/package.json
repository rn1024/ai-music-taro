{
  "name": "@creatoria/taro-ui",
  "version": "0.0.1",
  "description": "A Taro UI component library aligned with Radix UI",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lib/*": {
      "types": "./lib/*/index.d.ts",
      "import": "./lib/*/index.js",
      "require": "./lib/*/index.cjs"
    },
    "./dist/styles/*": "./dist/styles/*",
    "./lib/*/index.scss": "./lib/*/index.scss",
    "./lib/styles/*": "./lib/styles/*"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist",
    "lib",
    "es",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "dev:h5": "taro build --type h5 --watch",
    "dev:alipay": "taro build --type alipay --watch",
    "dev:tt": "taro build --type tt --watch",
    "serve:h5": "taro build --type h5 --watch",
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:lib": "rollup -c scripts/rollup.config.mjs",
    "build:components": "node scripts/build-components.mjs",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:all": "pnpm clean && pnpm build:lib && pnpm build:components",
    "clean": "rimraf dist lib es types coverage",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:weapp": "miniprogram-automator test",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "prepublish:check": "pnpm lint && pnpm typecheck && pnpm test",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "release": "pnpm prepublish:check && pnpm build:all && npm publish",
    "release:beta": "npm publish --tag beta",
    "release:alpha": "npm publish --tag alpha"
  },
  "peerDependencies": {
    "@tarojs/components": ">=4.0.0",
    "@tarojs/taro": ">=4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "classnames": "^2.3.2",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-transform-runtime": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@emotion/jest": "^11.11.0",
    "@playwright/test": "^1.49.0",
    "@rollup/plugin-babel": "^6.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@tarojs/cli": "4.x",
    "@tarojs/components": "4.x",
    "@tarojs/plugin-framework-react": "4.x",
    "@tarojs/plugin-platform-alipay": "4.x",
    "@tarojs/plugin-platform-h5": "4.x",
    "@tarojs/plugin-platform-tt": "4.x",
    "@tarojs/plugin-platform-weapp": "4.x",
    "@tarojs/react": "4.x",
    "@tarojs/runtime": "4.x",
    "@tarojs/shared": "4.x",
    "@tarojs/taro": "4.x",
    "@tarojs/test-utils-react": "^0.1.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10.4.0",
    "chalk": "^5.3.0",
    "concurrently": "^8.0.0",
    "conventional-changelog-cli": "^4.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "fast-glob": "^3.3.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "jest-image-snapshot": "^6.4.0",
    "miniprogram-automator": "^0.12.1",
    "postcss": "^8.4.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "rimraf": "^5.0.0",
    "rollup": "^4.0.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.0.0",
    "rollup-plugin-postcss": "^4.0.0",
    "rollup-plugin-terser": "^7.0.0",
    "sass": "^1.69.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "taro",
    "taro-ui",
    "mini-program",
    "react",
    "components",
    "ui-library",
    "radix"
  ],
  "author": "Creatoria",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/creatoria/taro-ui.git"
  },
  "bugs": {
    "url": "https://github.com/creatoria/taro-ui/issues"
  },
  "homepage": "https://github.com/creatoria/taro-ui#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.5.0+sha1.8c155dc114e1689d18937974f6571e0ceee66f1d",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@tarojs/react": "4.x",
        "@tarojs/runtime": "4.x",
        "@tarojs/shared": "4.x",
        "@tarojs/plugin-framework-react": "4.x"
      }
    }
  }
}
